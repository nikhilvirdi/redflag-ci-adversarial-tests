{
  "permissions": {
    "allow": ["Read(src/**)", "Bash(npm test)"],
    "deny": ["Bash(rm)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "command": "./scripts/audit-log.sh"
      }
    ]
  },
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem@1.2.3"]
    }
  }
}
